{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "infra-soubiran-dev",
  "compatibility_date": "2025-10-24",
  "routes": [
    {
      "pattern": "infra.soubiran.dev",
      "zone_name": "soubiran.dev",
      "custom_domain": true
    }
  ],
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "workers_dev": false,
  "preview_urls": false
}
